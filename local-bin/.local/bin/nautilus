#!/bin/bash
# Wrapper for Nautilus to restore the last visited directory when opened without path arguments.

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/nautilus/last-dir"

# Check if any argument is a path / location (i.e. does not start with '-')
has_path=false
for arg in "$@"; do
    if [[ "$arg" != -* ]]; then
        has_path=true
        break
    fi
done

# If no path argument was passed, try restoring the last visited directory
if [ "$has_path" = false ] && [ -f "$STATE_FILE" ]; then
    LAST_DIR=$(cat "$STATE_FILE" 2>/dev/null | tr -d '\r\n')
    if [ -n "$LAST_DIR" ] && [ -d "$LAST_DIR" ]; then
        exec /usr/bin/nautilus "$@" "$LAST_DIR"
    fi
fi

exec /usr/bin/nautilus "$@"
