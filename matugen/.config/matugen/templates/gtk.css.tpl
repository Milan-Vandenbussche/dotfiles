/* ── Libadwaita CSS Variables ────────────────────────────────────── */
:root, window, .background {
  --accent-color: {{ colors.primary.default.hex }};
  --accent-bg-color: {{ colors.primary.default.hex }};
  --accent-fg-color: {{ colors.on_primary.default.hex }};
  --window-bg-color: {{ colors.surface.default.hex }};
  --window-fg-color: {{ colors.on_surface.default.hex }};
  --view-bg-color: {{ colors.surface.default.hex }};
  --view-fg-color: {{ colors.on_surface.default.hex }};
  --headerbar-bg-color: {{ colors.surface_container_low.default.hex }};
  --headerbar-fg-color: {{ colors.on_surface.default.hex }};
  --sidebar-bg-color: {{ colors.surface_container_low.default.hex }};
  --sidebar-fg-color: {{ colors.on_surface.default.hex }};
  --card-bg-color: {{ colors.surface_container.default.hex }};
  --card-fg-color: {{ colors.on_surface.default.hex }};
  --popover-bg-color: {{ colors.surface_container_high.default.hex }};
  --popover-fg-color: {{ colors.on_surface.default.hex }};
}

/* ── Nautilus Direct Styling ─────────────────────────────────────── */
window.background.nautilus-window,
.nautilus-window,
.nautilus-window .view {
  background-color: {{ colors.surface.default.hex }} !important;
  color: {{ colors.on_surface.default.hex }} !important;
}

.nautilus-window headerbar {
  background-color: {{ colors.surface_container_low.default.hex }} !important;
  color: {{ colors.on_surface.default.hex }} !important;
  border-bottom: 1px solid {{ colors.outline_variant.default.hex }}30 !important;
}

.nautilus-window .navigation-sidebar,
.nautilus-window scrolledwindow.sidebar,
.nautilus-window splitview.sidebar {
  background-color: {{ colors.surface_container_low.default.hex }} !important;
  color: {{ colors.on_surface.default.hex }} !important;
}

/* Selected sidebar row */
.nautilus-window .navigation-sidebar row:selected {
  background-color: {{ colors.primary_container.default.hex }} !important;
  color: {{ colors.on_primary_container.default.hex }} !important;
  border-radius: 8px !important;
}

/* Selected file / folder in grid or list */
.nautilus-window .view:selected,
.nautilus-window flowboxchild:selected,
.nautilus-window listview row:selected {
  background-color: {{ colors.primary_container.default.hex }} !important;
  color: {{ colors.on_primary_container.default.hex }} !important;
  border-radius: 8px !important;
}

/* Suggested action / Primary Buttons */
button.suggested-action {
  background-color: {{ colors.primary.default.hex }} !important;
  color: {{ colors.on_primary.default.hex }} !important;
}
