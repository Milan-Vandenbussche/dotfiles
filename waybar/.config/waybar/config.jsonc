{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "group/tray-expander",
    "custom/gamemode",
    "custom/sep",
    "bluetooth",
    "network",
    "pulseaudio",
    "custom/systemmanager",
    "custom/sep",
    "clock",
    "custom/sep",
    "custom/power"
  ],

  // Workspace dots — only shows workspaces that have windows open (active-only).
  // The currently focused workspace gets the "active" CSS class (darker dot).
  // When a workspace is emptied and you leave it, it vanishes from the bar.
  "hyprland/workspaces": {
    "on-click": "activate",
    "active-only": false,
    "all-outputs": false,
    "show-special": false,
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "empty": "○"
    },
    // persistent-workspaces intentionally omitted — we want dynamic dots only
    "ignore-workspaces": ["special"]
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },

  // 24h time + day-of-week + date. No calendar, no tooltip, no on-click alt format.
  "clock": {
    "format": " {:%a %d %b  %H:%M}",
    "tooltip": false
  },

  "network": {
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon}",
    "on-click": "kitty wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 5,
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "custom/systemmanager": {
    "format": "󰍛",
    "on-click": "kitty -e btop",
    "tooltip": true,
    "tooltip-format": "Open btop"
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },

  "tray": {
    "icon-size": 12,
    "spacing": 8
  },

  "custom/sep": {
    "format": "|"
  },

  "custom/gamemode": {
    "exec": "test -f ~/.cache/hypr_gamemode && echo '{\"text\":\"\"}' || echo '{\"text\":\"\"}'",
    "on-click": "test -f ~/.cache/hypr_gamemode && (rm ~/.cache/hypr_gamemode && hyprctl keyword animations:enabled 1 && hyprctl keyword decoration:blur:enabled 1) || (touch ~/.cache/hypr_gamemode && hyprctl keyword animations:enabled 0 && hyprctl keyword decoration:blur:enabled 0)",
    "interval": 1,
    "return-type": "json",
    "tooltip": true,
    "tooltip-format": "GameMode: toggle blur & animations"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/scripts/power-menu.sh"
  }
}
